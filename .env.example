# AATM local runtime configuration — duplicate this file as .env if needed.
# Keep HOST bound to loopback unless you have deliberately configured a secure deployment.
HOST=127.0.0.1
PORT=8000
# SQLite is the zero-setup development database. Its parent folder is created automatically.
DATABASE_URL=sqlite:///./.aatm/aatm.db
# Vite development UI is normally http://127.0.0.1:5173.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Provider cost estimates (local, used for hard budget enforcement — NOT official prices).
# AATM_MODEL_PRICING={"your-model-id": {"input_per_million_usd": 3.0, "output_per_million_usd": 15.0}}

# Credential REFERENCES only. Never put an API key value in .env or anywhere AATM reads as a secret
# reference; export the key in the process environment and reference it here as env:NAME, e.g.
# ANTHROPIC_API_KEY=<exported outside this file>
# Then set the provider's credential_ref to env:ANTHROPIC_API_KEY through the API/UI.
# Live provider execution is intentionally disabled for the HTTP API in this build.
